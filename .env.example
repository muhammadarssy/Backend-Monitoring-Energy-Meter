# Port HTTP server
PORT=5000

# Redis — mirror buffer & device info dari collector
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=energy

# PostgreSQL — penyimpanan historis (readings, sessions, cycles)
DB_URL=postgresql://user:pass@localhost:5432/energy_db

# Sample dianggap basi (mesin offline) bila lebih tua dari ini (detik)
OFFLINE_THRESHOLD_SECONDS=10

# Power-graph: jendela waktu (jam) & ukuran bucket agregasi (menit)
POWER_GRAPH_WINDOW_HOURS=4
POWER_GRAPH_BUCKET_MINUTES=5

# Timezone untuk field rtc/timestamp pada response. UTC+7 = 420 menit
TZ_OFFSET_MINUTES=420
TZ_LABEL=UTC+7
